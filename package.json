{
  "name": "fangcun",
  "version": "0.1.13",
  "private": true,
  "description": "方寸 Fangcun — 个人资产台账：服务器、域名、证书、订阅、邮箱、号码、支付卡、账号、文档的到期与费用管理",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/server",
    "apps/web",
    "apps/cli"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build -w apps/web && npm run build -w apps/server && npm run build -w apps/cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "start": "node apps/server/dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "tsx": "^4.19.0"
  }
}
